    subHeader3: 
    body: 'Sample ending game state after the player wins the game (notice the isGameOver
      flag is true and the status is "playerWon"):'
    bodyFormat: 1
    boxCallout: 
    bulletList: []
    linkList: []
  - subHeader1: 
